rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Todo lo que no se nombra aquí queda DENEGADO.

    function signedIn() {
      return request.auth != null;
    }

    function isHost(room) {
      return get(/databases/$(database)/documents/rooms/$(room)).data.hostId == request.auth.uid;
    }

    match /rooms/{room} {
      // Se entra con el código de 5 caracteres: se puede leer UNA sala, pero
      // nadie puede listar/enumerar todas las salas.
      allow get: if signedIn();
      allow list: if false;

      // Solo se puede crear una sala en la que uno mismo es el anfitrión.
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.keys().size() <= 60
        && room.matches('[A-Z0-9]{5}');

      // El anfitrión no se puede cambiar ni robar, y el tamaño queda acotado.
      // (Los demás jugadores actualizan la sala al unirse/jugar: el juego es
      // cliente-autoritativo, por eso aquí no se puede exigir ser anfitrión.)
      allow update: if signedIn()
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.keys().size() <= 60;

      // Nadie borra salas desde la app.
      allow delete: if false;

      match /players/{uid} {
        allow get, list: if signedIn();

        // Cada jugador crea/edita solo su propio documento, con nombre acotado.
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().size() <= 40
          && (!('name' in request.resource.data)
              || (request.resource.data.name is string
                  && request.resource.data.name.size() <= 40));

        // El anfitrión actualiza a todos (puntajes y reinicio de ronda).
        allow update: if signedIn()
          && isHost(room)
          && request.resource.data.keys().size() <= 40;

        allow delete: if false;
      }
    }
  }
}
